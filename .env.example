# Provider API keys (not used until later phases)
OPENAI_API_KEY=
GROQ_API_KEY=

# Database (Phase 1)
DATABASE_URL=postgresql+asyncpg://gateway:gateway@db:5432/gateway
POSTGRES_USER=gateway
POSTGRES_PASSWORD=gateway
POSTGRES_DB=gateway

# Redis (provisioned in Phase 0 compose; not used by app code until Phase 5)
REDIS_URL=redis://redis:6379/0

# Misc (used starting later phases; kept here for a stable .env across phases)
DEFAULT_RATE_LIMIT_PER_MIN=60
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_COOLDOWN_SECONDS=30
RETRY_MAX_ATTEMPTS=3
LOG_LEVEL=INFO
